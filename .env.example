ODDS_API_KEY=your-key-here

# Shared site login. All three are required; if any is missing, every page redirects to /login.
AUTH_USER=your-username
AUTH_PASSWORD=a-long-random-password
SESSION_SECRET=another-long-random-string

# Gmail SMTP: create an App Password (2FA on), not your login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=you@gmail.com
EMAIL_TO=friend@gmail.com
